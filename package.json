{
  "name": "isaozler-shiftselector-panel",
  "version": "2.0.0",
  "packageManager": "pnpm@8.6.0",
  "description": "",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "pnpm run /^e2e:.*/",
    "e2e:install": "npm exec cypress install",
    "e2e:grafana-e2e": "npm exec grafana-e2e run",
    "e2e:update": "npm exec grafana-e2e run --update-screenshots",
    "lint": "pnpm run /^lint:.*/",
    "lint:eslint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx . --fix",
    "lint:prettier": "prettier --write .",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "vitest": "pnpm run /^vitest:.*/",
    "vitest:init": "vitest",
    "vitest:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build-check": "npm run typecheck && npm run lint && npm run test:ci && npm run build",
    "release-check": "npm ci && npm run typecheck && npm run lint && npm run test:ci && npm run build npm run e2e && npm run sign"
  },
  "homepage": "https://github.com/isaozler/grafana-shift-selector",
  "bugs": "https://github.com/isaozler/grafana-shift-selector/issues",
  "repository": "github:isaozler/grafana-shift-selector",
  "author": {
    "name": "Isa Ozler",
    "email": "contactme@isaozler.com",
    "url": "https://isaozler.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.16.7",
    "@grafana/e2e": "^10.4.2",
    "@grafana/e2e-selectors": "9.3.8",
    "@grafana/eslint-config": "^5.1.0",
    "@grafana/tsconfig": "^1.2.0-rc1",
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.3.51",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.23",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.4",
    "@types/jest": "28",
    "@types/lodash": "^4.14.188",
    "@types/node": "^18.11.9",
    "@types/react": "18.2.24",
    "@types/react-datepicker": "^4.11.2",
    "@types/react-dom": "18.2.24",
    "@types/sqlstring": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-istanbul": "^3.0.9",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "eslint-plugin-jsdoc": "^48.2.3",
    "eslint-webpack-plugin": "^3.1.1",
    "fork-ts-checker-webpack-plugin": "^7.2.0",
    "glob": "^10.0.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "28",
    "jest-environment-jsdom": "28",
    "prettier": "^2.5.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1",
    "redux-devtools-extension": "^2.13.9",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.56.1",
    "sass-loader": "13.2.0",
    "style-loader": "3.3.1",
    "swc-loader": "^0.2.3",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^4.4.0",
    "vitest": "^2.0.5",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@grafana/data": "^10.3.3",
    "@grafana/runtime": "^10.4.2",
    "@grafana/toolkit": "^10.1.9",
    "@grafana/ui": "^10.3.3",
    "@stitches/react": "^1.2.8",
    "react": "19.0.0",
    "react-datepicker": "^4.11.0",
    "react-dom": "19.0.0",
    "rxjs": "^7.8.1",
    "sqlstring": "^2.3.3",
    "tslib": "2.5.0",
    "zustand": "^5.0.3"
  },
  "resolutions": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint-plugin-jsdoc": "^48.2.3"
  }
